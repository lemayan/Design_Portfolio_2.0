{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nomad-play-portfolio",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "lemayanleleina.tech",
      "custom_domain": true
    },
    {
      "pattern": "www.lemayanleleina.tech",
      "custom_domain": true
    }
  ],
  "vars": {
    "CONTACT_ALLOWED_HOST": "lemayanleleina.tech",
    "CONTACT_FROM": "Portfolio <contact@lemayanleleina.tech>",
    "CONTACT_TO": "lemayanleleina@gmail.com"
  },
  "observability": {
    "enabled": true
  }
}
